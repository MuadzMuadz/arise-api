# ARISE API — Environment Template
# Copy ke `.env` lalu isi value-nya. Jangan commit `.env` (sudah di .gitignore).
#
# Dev setup: lihat README "First-Time Setup" + ADR 0002.

# ── Runtime ──
NODE_ENV=development
PORT=3000
API_PREFIX=v1
CORS_ORIGIN=http://localhost:3000

# ── Database (Postgres) ──
# Reuse `airis_postgres` container yang udah jalan (port host 5433, Postgres 16).
# Database `arise_dev` + user `arise` di-create via `pnpm db:setup` (lihat scripts/setup-db.sh).
# Ganti PASSWORD di-bawah dengan yang lu set di scripts/setup-db.sh.
DATABASE_URL=postgresql://arise:CHANGE_ME@localhost:5433/arise_dev?schema=public

# ── Auth (JWT) ──
# Generate via: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand_hex_32_2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Mail ──
# Phase 1 dev: `console` transport — email di-cetak ke stdout. Zero footprint.
# Phase 2 prod: `smtp` + isi MAIL_HOST/PORT/USER/PASSWORD.
MAIL_TRANSPORT=console
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USER=
# MAIL_PASSWORD=
MAIL_FROM=ARISE <noreply@tap-in.click>
# MAIL_SECURE=false

# ── Redis (Phase 2: BullMQ) ──
# Phase 1: penalty cron pake @nestjs/schedule in-process. Redis OFF.
# Uncomment + install `sudo apt install redis-server` pas Phase 2.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ── External APIs (Phase 2) ──
# CLAUDE_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
ALADHAN_API_BASE=https://api.aladhan.com/v1
