# Default behavior: normalize line endings to LF in repo.
# Working dir checkout adapt ke platform native (CRLF di Windows, LF di Linux/macOS).
* text=auto eol=lf

# Source code — explicit LF
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.env*      text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Windows-only files — keep CRLF (kalo ada)
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary — no normalization
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
*.lockb     binary

# Lockfile — keep as-is, no merge conflict resolution attempt
pnpm-lock.yaml -diff merge=ours
